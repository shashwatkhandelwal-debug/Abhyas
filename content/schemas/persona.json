{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona",
  "type": "object",
  "required": [
    "id",
    "name",
    "grade",
    "voice_id",
    "misconceptions",
    "temperament",
    "speech_style_hi"
  ],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "grade": {"type": "integer"},
    "voice_id": {"type": "string"},
    "misconceptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "temperament": {
      "type": "string",
      "enum": ["shy", "confident", "distracted"]
    },
    "speech_style_hi": {"type": "string"}
  }
}
