# ==============================================================================
# Abhyas - Environment Configuration (.env.example)
# AI for Foundational Learning Hackathon 2026 - Challenge 3: Teacher Support & Training
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database (PostgreSQL with pgvector / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/abhyas
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abhyas

# Job Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-7-sonnet-20250219
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=1

# WhatsApp Business Cloud API / BSP
WHATSAPP_VERIFY_TOKEN=abhyas_webhook_verify_token_secure
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_APP_SECRET=your_app_secret
BSP_PROVIDER=gupshup
BSP_API_KEY=your_bsp_api_key_here

# Speech-to-Text (STT) & Text-to-Speech (TTS)
STT_PROVIDER=indic_conformer  # options: indic_conformer, hosted_api, mock
STT_ENDPOINT=http://localhost:8001/transcribe
STT_API_KEY=

TTS_PROVIDER=indic_parler_tts # options: indic_parler_tts, hosted_api, mock
TTS_ENDPOINT=http://localhost:8002/synthesize
TTS_API_KEY=

# Thresholds & Limits (strictly defined - no magic numbers)
LATENCY_P95_TARGET_MS=20000
COACH_CONFIDENCE_THRESHOLD=0.60
AGGREGATION_SUPPRESSION_N=10
MAX_TURNS_PER_REHEARSAL=8
MAX_REHEARSAL_RETRIES_PER_WEEK=3
TWO_DAY_FOLLOWUP_HOURS=48
EXPLAIN_BACK_MAX_SECONDS=60
LEARN_AUDIO_MAX_SECONDS=120
MAX_CHILD_LINE_WORDS=25
MAX_COACH_FEEDBACK_WORDS=60
MAX_GUIDE_ANSWER_WORDS=80
